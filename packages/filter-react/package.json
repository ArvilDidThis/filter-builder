{
  "name": "@arvilmena/filter-react",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Filter builder for React: headless state and actions, plus ready-made components with default styling.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.mts",
      "default": "./dist/ui.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@arvilmena/filter-core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@arvilmena/filter-core": "workspace:^",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
