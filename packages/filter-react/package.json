{
  "name": "@arvilmena/filter-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Filter builder for React: headless state and actions, plus ready-made components with default styling.",
  "keywords": [
    "react",
    "filter",
    "filter-builder",
    "query-builder",
    "searchbuilder",
    "datatables",
    "headless"
  ],
  "homepage": "https://github.com/ArvilDidThis/filter-builder#readme",
  "bugs": "https://github.com/ArvilDidThis/filter-builder/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArvilDidThis/filter-builder.git",
    "directory": "packages/filter-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.mts",
      "default": "./dist/ui.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:update": "vitest run --config vitest.browser.config.ts browser/picker-look.test.tsx --update",
    "typecheck": "tsc -p tsconfig.json && tsc -p browser/tsconfig.json"
  },
  "peerDependencies": {
    "@arvilmena/filter-core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@arvilmena/filter-core": "workspace:^",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
