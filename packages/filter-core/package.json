{
  "name": "@arvilmena/filter-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Filter format, matching rules and helpers for the filter builder. Runs anywhere JavaScript runs.",
  "keywords": [
    "filter",
    "filter-builder",
    "query-builder",
    "searchbuilder",
    "datatables",
    "headless"
  ],
  "homepage": "https://github.com/ArvilDidThis/filter-builder#readme",
  "bugs": "https://github.com/ArvilDidThis/filter-builder/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArvilDidThis/filter-builder.git",
    "directory": "packages/filter-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify:entry": "node scripts/verify-entry.mjs"
  },
  "peerDependencies": {
    "effect": "^4.1.2"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "datatables.net": "3.1.5",
    "datatables.net-searchbuilder": "2.1.1",
    "effect": "4.1.2",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
