{
  "name": "filter-builder",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Headless filter builder: filter format, matching rules and builder UI.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm -r run verify:entry && pnpm test:scripts",
    "test:scripts": "node --test \".github/scripts/__tests__/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "7.0.2"
  }
}
